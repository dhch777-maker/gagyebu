{
  "$schema": "health-checkup-v1",
  "description": "건강검진 결과 구조화 스키마. 새 연도 PDF 추가 시 이 구조를 따른다.",
  "field_rules": {
    "value":  "수치 값. 측정하지 않았거나 확인 불가 시 null",
    "unit":   "단위 (mg/dL, U/L, kg, cm 등)",
    "status": "정상 | 높음 | 낮음 | 주의 | 비대상",
    "ref":    "참고치 범위 (문자열)",
    "note":   "보충 설명",
    "finding":"영상/내시경 소견 텍스트"
  },
  "sections": {
    "meta": ["year", "date", "institution", "age", "sex"],
    "basic": "신체계측 (신장, 체중, BMI, 허리둘레, 혈압, 시력, 청력)",
    "body_composition": "체성분 분석 (InBody 등, 해당 시에만)",
    "blood": {
      "cbc":          "일반혈액검사 (WBC, RBC, Hb, Hct, MCV, MCH, MCHC, 백혈구 감별)",
      "liver":        "간기능 (총단백, 알부민, 빌리루빈, AST, ALT, ALP, GGT, LDH)",
      "lipid":        "지질 (총콜레스테롤, HDL, LDL, 중성지방)",
      "kidney":       "신장기능 (BUN, 크레아티닌, eGFR, 요산)",
      "diabetes":     "당뇨 (공복혈당, HbA1c)",
      "inflammation": "염증 (hs-CRP, ESR)",
      "cardiac":      "심장표지자 (Soluble ST2, CK 등)",
      "thyroid":      "갑상선 (TSH, Free T4)",
      "tumor_markers":"종양표지자",
      "iron":         "철분 (혈청철, 페리틴)"
    },
    "urine": "요검사",
    "imaging": "영상검사 (흉부X선, CT, 초음파 등)",
    "endoscopy": "내시경 (위내시경, 대장내시경 등)",
    "special": "특수검사 (심전도, 골밀도, 동맥경화도, NK세포, 대사나이, 건강유형 등)",
    "genetics": "유전체검사 (심뇌혈관, 암 등 - 해당 시에만)",
    "flags": "주의/이상 항목 요약 배열 [{category, item, value, status, action}]"
  },
  "versioning": "파일명은 연도.json (예: 2024.json, 2025.json, 2026.json)"
}
